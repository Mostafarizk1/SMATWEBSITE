# Public base URL of the site (no trailing slash). Used for canonical URLs, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to show the palette switcher outside development (e.g. on a Vercel preview for review).
NEXT_PUBLIC_THEME_SWITCHER=0

# 21st.dev Magic MCP (optional, dev tooling only). Read by .mcp.json, never shipped to the browser.
# TWENTY_FIRST_API_KEY=
